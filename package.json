{
  "name": "brain-trail",
  "version": "2.3.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "omp": {
    "extensions": [
      "./hosts/omp/index.ts"
    ]
  },
  "scripts": {
    "build:browser": "bun scripts/build-browser.mjs",
    "check:browser-build": "bun scripts/build-browser.mjs --check",
    "build:relay": "node scripts/build-relay.mjs",
    "check:relay-build": "node scripts/build-relay.mjs --check",
    "check:sdk": "node scripts/check-sdk.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:views": "node scripts/view-parity.mjs --base ${VIEW_BASE:-${RELEASE_BASE:-origin/main}}",
    "lint": "biome lint --error-on-warnings hooks hosts tests scripts types",
    "format": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false --enforce-assist=false scripts hosts package.json biome.jsonc tsconfig.json tsconfig.core.json tsconfig.omp.json tsconfig.browser.json types/model.ts types/contracts.ts types/view.ts hooks tests",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --project tsconfig.core.json",
    "typecheck:omp": "tsc --project tsconfig.omp.json && tsc --project tsconfig.browser.json",
    "test": "node node_modules/@anthropic-ai/claude-code/cli-wrapper.cjs plugin test .",
    "validate": "node node_modules/@anthropic-ai/claude-code/cli-wrapper.cjs plugin validate --strict .",
    "prepare": "node scripts/install-lefthook.mjs",
    "test:tooling": "node --test scripts/quality.test.mjs",
    "test:omp": "bun scripts/omp-test.mjs",
    "verify": "bun run check:browser-build && bun run check:relay-build && bun run check:sdk && bun run check:release && bun run test:tooling && bun run validate && bun run test && bun run test:omp && bun run lint && bun run format && bun run typecheck:core && bun run typecheck && bun run typecheck:omp && bun run check:views"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.322",
    "@biomejs/biome": "2.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oh-my-pi/pi-coding-agent": "18.18.9",
    "@types/bun": "1.4.4",
    "@types/three": "0.160.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "lefthook": "2.2.2",
    "marked": "18.2.0",
    "playwright": "1.65.0",
    "semver": "7.8.6",
    "three": "0.160.0",
    "typescript": "5.9.3"
  }
}
